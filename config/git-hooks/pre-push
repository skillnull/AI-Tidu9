#!/bin/sh
set -eu

if ! IFS=' ' read -r local_ref local_object remote_ref remote_object; then
  exit 0
fi

pending_refs="$local_ref $local_object $remote_ref $remote_object"
while IFS=' ' read -r local_ref local_object remote_ref remote_object; do
  pending_refs="$pending_refs
$local_ref $local_object $remote_ref $remote_object"
done

. "$(git rev-parse --show-toplevel)/scripts/use-project-node.sh"

printf '%s\n' "$pending_refs" | node scripts/check-project.mjs --pre-push
