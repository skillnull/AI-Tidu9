{
  "name": "ai-tidu9-workspace",
  "private": true,
  "description": "九门赛博提督·智能协作中枢",
  "license": "AGPL-3.0-only",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "build:tidu": "npm run build --workspace @skillnull/tidu",
    "check": "npm run policy -- versions && npm run lint && npm test",
    "lint": "biome check --config-path=config/biome.json .",
    "prepare": "node scripts/install-git-hooks.mjs",
    "policy": "node scripts/project-policy.mjs",
    "publish:tidu": "node scripts/publish-tidu.mjs",
    "test": "node --test scripts/*.test.mjs && npm run test --workspaces --if-present"
  },
  "engines": {
    "node": ">=18.20.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "18.19.130",
    "typescript": "7.0.2"
  }
}
