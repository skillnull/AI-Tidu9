{
  "name": "ai-tidu9-workspace",
  "private": true,
  "description": "九门赛博提督·智能协作中枢",
  "license": "AGPL-3.0-only",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "tidu:setup": "sh -c '. ./scripts/use-project-node.sh && npm install --no-package-lock'",
    "build": "sh -c '. ./scripts/use-project-node.sh && npm run build --workspaces --if-present'",
    "build:tidu": "sh -c '. ./scripts/use-project-node.sh && npm run build --workspace @skillnull/tidu'",
    "tidu:dev-p": "sh -c '. ./scripts/use-project-node.sh && exec node scripts/dev-tidu.mjs'",
    "tidu:dev-e": "sh -c '. ./scripts/use-project-node.sh && TIDU_DEV_EDITION=enterprise exec node scripts/dev-tidu.mjs'",
    "tidu:cli-p": "sh -c '. ./scripts/use-project-node.sh && export TIDU_DATABASE_PATH=\"${TIDU_DATABASE_PATH:-.tidu-dev/tidu.sqlite}\" && exec node packages/tidu/dist/cli/launcher.js \"$@\"' --",
    "tidu:cli-e": "sh -c '. ./scripts/use-project-node.sh && export TIDU_DATABASE_PATH=\"${TIDU_DATABASE_PATH:-.tidu-dev/enterprise.sqlite}\" && export TIDU_EDITION=enterprise && exec node packages/tidu/dist/cli/launcher.js \"$@\"' --",
    "check": "sh -c '. ./scripts/use-project-node.sh && npm run policy -- versions && npm run lint && npm test'",
    "lint": "sh -c '. ./scripts/use-project-node.sh && biome check --config-path=config/biome.json .'",
    "prepare": "sh -c '. ./scripts/use-project-node.sh && node scripts/install-git-hooks.mjs'",
    "policy": "sh -c '. ./scripts/use-project-node.sh && node scripts/project-policy.mjs \"$@\"' --",
    "publish:tidu": "sh -c '. ./scripts/use-project-node.sh && node scripts/publish-tidu.mjs'",
    "test": "sh -c '. ./scripts/use-project-node.sh && node --test --test-reporter=dot scripts/*.test.mjs && npm run test --workspaces --if-present && python3 -m unittest discover -s sdk/python/tests'"
  },
  "engines": {
    "node": ">=22.14.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
